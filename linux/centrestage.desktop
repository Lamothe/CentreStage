[Desktop Entry]
Name=Centre Stage
Comment=View glTF and GLB 3D models
Exec=env XDG_SESSION_TYPE=x11 WAYLAND_DISPLAY=wayland-none "@BINDIR@/CentreStage" %f
Icon=centrestage
Terminal=false
Type=Application
Categories=Graphics;3DGraphics;Viewer;
MimeType=model/gltf-binary;model/gltf+json;
StartupNotify=true
